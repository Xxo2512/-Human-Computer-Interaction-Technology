# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ---------- venv ----------
.venv/
venv/
env/
ENV/

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Data: 原始与中间产物不进 git ----------
# DEAP 数据非常大(>1GB),且有授权限制,绝不能提交
data/raw/*
data/preproc/*
data/epochs/*
!data/raw/.gitkeep
!data/preproc/.gitkeep
!data/epochs/.gitkeep

# 特征与模型缓存
features/*
!features/.gitkeep
models/*.pkl
models/*.joblib
models/*.pt
!models/.gitkeep

# 报告里的图可以进 git,但大文件不行
reports/figs/*.pdf
reports/*.docx
reports/*.pptx

# ---------- 日志 / 临时文件 ----------
*.log
logs/
tmp/
.cache/

# ---------- 环境变量 ----------
.env
.env.local

# ---------- 测试/覆盖率 ----------
.pytest_cache/
.coverage
htmlcov/
